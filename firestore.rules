rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cenários do laboratório: cada usuário lê e escreve apenas os próprios.
    match /users/{uid}/scenarios/{scenarioId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Cache público de dados oficiais: IBGE (UFs e municípios, renovável a
    // cada 30 dias) e Banco Central (indicadores, renovável a cada 12 horas).
    // Qualquer usuário autenticado pode criar o cache ou renová-lo vencido.
    match /datasets/{id} {
      allow read: if true;
      allow create: if isValidDataset(id);
      allow update: if isValidDataset(id)
        && request.time > resource.data.fetchedAtTs
           + (id == 'bcb-macro' ? duration.value(12, 'h') : duration.value(30, 'd'));
    }

    function isValidDataset(id) {
      let d = request.resource.data;
      return request.auth != null
        && id.matches('^(ibge-(uf|municipios-[A-Z]{2})|bcb-macro)$')
        && d.keys().hasOnly(['data', 'fetchedAtTs'])
        && d.fetchedAtTs == request.time
        && d.data is map;
    }

    // Turmas e grupos: qualquer pessoa com o código lê; só o dono altera.
    match /groups/{code} {
      allow read: if true;
      allow create: if isValidGroup(code) && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isValidGroup(code) && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // Placar do grupo: cada jogador grava só a própria linha.
      match /results/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['initials', 'office', 'uf', 'score', 'justice', 'green',
                                                    'laws', 'objectives', 'achievements', 'createdAt'])
          && request.resource.data.initials is string && request.resource.data.initials.matches('^[A-Z]{2,3}$')
          && request.resource.data.uf is string && request.resource.data.uf.matches('^[A-Z]{2}$')
          && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 5000
          && request.resource.data.justice is int && request.resource.data.justice >= 0 && request.resource.data.justice <= 500
          && request.resource.data.green is int && request.resource.data.green >= 0 && request.resource.data.green <= 100
          && request.resource.data.laws is int && request.resource.data.laws >= 0 && request.resource.data.laws <= 100
          && request.resource.data.objectives is int && request.resource.data.objectives >= 0 && request.resource.data.objectives <= 4
          && request.resource.data.achievements is int && request.resource.data.achievements >= 0 && request.resource.data.achievements <= 50
          && request.resource.data.createdAt == request.time;
      }

      // Votação do debate: um voto por pessoa, que pode ser trocado.
      match /votes/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['side', 'createdAt'])
          && request.resource.data.side in ['a', 'b']
          && request.resource.data.createdAt == request.time;
      }
    }

    function isValidGroup(code) {
      let d = request.resource.data;
      return request.auth != null
        && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && d.keys().hasOnly(['ownerUid', 'name', 'kind', 'spec', 'office', 'debate', 'createdAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.kind in ['turma', 'grupo']
        && d.spec is map && d.spec.title is string && d.spec.title.size() <= 80
        && d.spec.summary is string && d.spec.summary.size() <= 400
        && d.spec.objectives is list && d.spec.objectives.size() <= 3
        && (d.office == null || d.office in ['vereador', 'prefeito', 'deputado-estadual', 'governador',
                                             'deputado-federal', 'senador', 'presidente', 'ministro-stf'])
        && (d.debate == null || (d.debate is string && d.debate.size() <= 40))
        && d.createdAt is timestamp;
    }

    // Ranking público. Só as iniciais são exibidas; o id do documento é
    // "{missionId}__{cargo}__{uid}", uma entrada por jogador, cenário e cargo.
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if isValidEntry(entryId);
      // Só substitui a entrada por uma pontuação maior.
      allow update: if isValidEntry(entryId)
        && request.resource.data.score > resource.data.score;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    function isValidEntry(entryId) {
      let d = request.resource.data;
      return request.auth != null
        && d.keys().hasOnly(['missionId', 'office', 'uf', 'uid', 'initials', 'score', 'territory',
                             'yearsInOffice', 'laws', 'quiz', 'objectivesMet', 'separation',
                             'modelVersion', 'createdAt', 'justice', 'green', 'season'])
        && d.uid == request.auth.uid
        && d.missionId is string && d.missionId.size() <= 40
        && d.office in ['vereador', 'prefeito', 'deputado-estadual', 'governador',
                        'deputado-federal', 'senador', 'presidente', 'ministro-stf']
        && entryId == d.missionId + '__' + d.office + '__' + request.auth.uid
        && d.uf is string && d.uf.matches('^[A-Z]{2}$')
        && d.initials is string && d.initials.matches('^[A-Z]{2,3}$')
        && d.territory is int && d.territory >= 0 && d.territory <= 3000
        && d.yearsInOffice is int && d.yearsInOffice >= 0 && d.yearsInOffice <= 300
        && d.laws is int && d.laws >= 0 && d.laws <= 1200
        && d.quiz is int && d.quiz >= 0 && d.quiz <= 240
        && d.objectivesMet is int && d.objectivesMet >= 0 && d.objectivesMet <= 3
        && d.score is int
        && d.score == d.territory + d.yearsInOffice + d.laws + d.quiz + d.objectivesMet * 100
        && d.separation in ['amigavel', 'intermediaria', 'conflituosa']
        && d.modelVersion is int
        && d.createdAt == request.time
        // Rankings temáticos (opcionais em entradas antigas).
        && (!('justice' in d) || (d.justice is int && d.justice >= 0 && d.justice <= 500))
        && (!('green' in d) || (d.green is int && d.green >= 0 && d.green <= 100))
        && (!('season' in d) || (d.season is string && d.season.matches('^[0-9]{4}-T[1-4]$')));
    }
  }
}
